# CAMEL Sentinel — environment template
#
# 1. Copy this file and name the copy `.env` (same folder as this file):
#      macOS/Linux:  cp .env.example .env
#      Windows:      copy .env.example .env
# 2. Fill in the values below with YOUR OWN Azure credentials.
# 3. Never share or commit your .env file — it contains private keys.
#
# All of these are OPTIONAL. Without them, bank scoring, SHAP/LIME
# explanations, the RAI audit, documentation, and GNN fraud detection all
# work normally. Only the Chat Assistant page needs the Azure OpenAI values,
# and only its voice mode needs the Azure Speech values — those features
# show a "not configured" message until you fill these in.

# --- Azure OpenAI — powers the Chat Assistant page ---
# Azure portal > your Azure OpenAI resource > "Keys and Endpoint"
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
# The name YOU gave your model deployment in Azure AI Foundry (e.g. gpt-5-mini)
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-08-07-preview

# --- Azure Speech — powers voice input/output on the Chat Assistant page ---
# Azure portal > your Speech resource > "Keys and Endpoint"
# The region must match the resource's region exactly (e.g. eastus, westeurope)
AZURE_SPEECH_KEY=<your-azure-speech-key>
AZURE_SPEECH_REGION=<your-region>
